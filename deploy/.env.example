# 复制成 .env 后填真值：cp .env.example .env && chmod 600 .env
# .env 永远不进 git（已在 .gitignore 里），也不要贴进聊天/工单/截图

# ---- 中间件口令：随机串、长度 20 以上，只用大小写字母和数字 ----
# compose 会把口令插进 redis 启动参数，$ " 空格这类字符会被解析坏，导致 redis 起不来
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql
REDIS_PASSWORD=CHANGE_ME_redis
RABBITMQ_USER=pixark
RABBITMQ_PASSWORD=CHANGE_ME_mq

# ---- 腾讯云 COS ----
# 上 CDN 后要改的就是这一行：换成 https://img.你的域名
# 改完还要用 SQL 把库里已有图片的旧域名替换成新域名，否则删图时截取不到对象 key、文件删不掉
COS_HOST=https://your-bucket.cos.ap-beijing.myqcloud.com
COS_REGION=ap-beijing
COS_BUCKET=your-bucket
# 建议用子账号（协作者）的密钥，只授予这个桶的读写，别用主账号
COS_SECRET_ID=
COS_SECRET_KEY=

# ---- 阿里云百炼（AI 图片编辑）----
# 必须是华北2（北京）地域的 Key
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
